# Settings for intune_policy.py
# Copy this file to .env in the same folder and fill in the values.
# .env is in .gitignore: never commit it (it holds the client secret).

# Entra admin center -> App registrations -> app-kh-intune-automation -> Overview
KH_TENANT_ID=<directory (tenant) ID of IronWolfBV.onmicrosoft.com>
KH_CLIENT_ID=<application (client) ID of app-kh-intune-automation>

# Certificates & secrets -> client secret VALUE (from the password manager)
# Expires 3 Dec 2026 together with the trial.
KH_CLIENT_SECRET=<client secret value>

# Entra ID -> Groups -> grp-kh-staff-devices -> Object ID
# apply assigns the policy to this group ONLY (no All devices, no exclusions)
KH_ASSIGN_GROUP_ID=<object ID of grp-kh-staff-devices>

# Optional: where the policy JSON lives (default: policies/cp-kh-windows-baseline.json)
# KH_POLICY_FILE=
