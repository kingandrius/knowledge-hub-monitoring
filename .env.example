# Copy to .env next to monitoring.py (never commit .env).
KH_API_URL=https://app-kh-api-XXXX.azurewebsites.net/api/v1
KH_API_KEY=<key from the password manager>
# Optional overrides (default: system host name and the address used to reach the API)
# KH_HOSTNAME=monitoring-1
# KH_HOST_IP=10.10.10.30

# Agent mode (CS2 collector design): send to Monitoring-1 instead of Azure
# KH_API_URL=https://10.10.10.30:8443/api/v1
# KH_API_KEY=<this host's collector key>
# KH_CA_BUNDLE=/opt/kh-monitoring/collector.crt
