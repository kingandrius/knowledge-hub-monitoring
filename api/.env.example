# Copy to .env (never commit .env). Generate a key with: python tools/make_api_key.py
KH_API_KEY_HASHES=<sha256-of-key-1>[,<sha256-of-key-2-during-rotation>]
KH_STORAGE_BACKEND=sqlite          # memory | sqlite | azuresql
KH_SQLITE_PATH=instance/khapi.db
# Azure SQL (Task 4). On App Service: managed identity, no password.
# KH_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql-kh-cs2-g56bk3uo5ftsq.database.windows.net,1433;Database=sqldb-kh-knowledgehub;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;Authentication=ActiveDirectoryMsi
KH_MAX_BATCH_SIZE=500
KH_MAX_AGE_DAYS=30
KH_LOG_LEVEL=INFO
KH_LOG_FILE=logs/api.log           # leave empty on App Service (stdout is collected)
