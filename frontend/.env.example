# Copy to .env (never commit .env)

# Monitoring API, including /api/v1
KH_API_URL=http://127.0.0.1:5000/api/v1
# A key made with api/tools/make_api_key.py; its hash goes in the API's KH_API_KEY_HASHES
KH_API_KEY=<frontend-api-key>

# Entra ID sign-in (tenant IronWolfBV, app registration app-kh-monitoring-web)
KH_TENANT_ID=38896d7e-2d9f-42b6-bbf0-53491234b7d0
KH_CLIENT_ID=0646c673-60cb-4c23-aa61-323d4919d729
KH_CLIENT_SECRET=b7fb9296-4d44-4fe0-ae7c-4c057b2f95bc
# Must match a redirect URI in the app registration exactly
KH_REDIRECT_URI=http://localhost:8000/auth/redirect
# 0 only for local http testing; 1 (default) = session cookie only over HTTPS
KH_COOKIE_SECURE=0
